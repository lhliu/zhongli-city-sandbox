{
  "name": "zhongli-city-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply zhongli-sandbox --local",
    "db:seed:local": "wrangler d1 execute zhongli-sandbox --local --file=seed/seed_reference.sql",
    "pages:dev": "wrangler pages dev dist --d1 DB=zhongli-sandbox --r2 ASSETS_BUCKET --binding DEV_AUTH=1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@turf/boolean-within": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/kinks": "7.4.0",
    "@turf/union": "7.4.0",
    "hono": "4.13.13",
    "papaparse": "5.7.0",
    "proj4": "2.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@playwright/test": "1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
